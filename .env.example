POSTGRES_USER=threatuser
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_DB=threatdb
DATABASE_URL=postgresql://threatuser:replace-with-a-local-development-password@localhost:5432/threatdb

KAFKA_BOOTSTRAP_SERVERS=localhost:9094
RAW_NETWORK_EVENTS_TOPIC=raw.network-events
NORMALIZED_NETWORK_EVENTS_TOPIC=normalized.network-events
DETECTIONS_TOPIC=detections
DEAD_LETTER_TOPIC=dead-letter-events
KAFKA_TOPIC=network_traffic
KAFKA_WORKER_GROUP_ID=ndr-detection-worker

JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

THREAT_INTEL_EXTERNAL_ENABLED=false
THREAT_INTEL_CACHE_TTL_SECONDS=3600
AUTH_RATE_LIMIT_PER_MINUTE=10
PREDICT_RATE_LIMIT_PER_MINUTE=60
